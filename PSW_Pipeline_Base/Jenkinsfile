pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JDK21'
    }

    environment {
        APP_NAME        = 'psw-pipeline-base'
        SONAR_PROJECT   = 'psw-pipeline-base'
        SONAR_HOST      = 'http://localhost:9000'
        JMETER_HOME     = 'C:/apache-jmeter'
        JMETER_PLAN     = 'src/test/jmeter/pipeline_load_test.jmx'
        JMETER_RESULTS  = 'target/jmeter/results'
        SLACK_CHANNEL   = '#pipeline-notificaciones'
    }

    stages {

        // ─────────────────────────────────────────────
        // ETAPA 1: Checkout
        // ─────────────────────────────────────────────
        stage('Checkout') {
            steps {
                echo '>>> [1/5] Obteniendo codigo fuente...'
                checkout scm
            }
        }

        // ─────────────────────────────────────────────
        // ETAPA 2: Build
        // ─────────────────────────────────────────────
        stage('Build') {
            steps {
                echo '>>> [2/5] Compilando el proyecto...'
                dir('PSW_Pipeline_Base') {
                    bat 'mvn clean package -DskipTests'
                }
                echo 'Build completado correctamente.'
            }
            post {
                success {
                    archiveArtifacts artifacts: 'PSW_Pipeline_Base/target/*.jar', fingerprint: true
                }
            }
        }

        // ─────────────────────────────────────────────
        // ETAPA 3: Tests + cobertura JaCoCo
        // ─────────────────────────────────────────────
        stage('Test') {
            steps {
                echo '>>> [2.5/5] Ejecutando tests y generando reporte JaCoCo...'
                dir('PSW_Pipeline_Base') {
                    bat 'mvn test'
                }
            }
            post {
                always {
                    junit testResults: 'PSW_Pipeline_Base/target/surefire-reports/*.xml',
                          allowEmptyResults: true
                    jacoco(
                        execPattern: 'PSW_Pipeline_Base/target/jacoco.exec',
                        classPattern: 'PSW_Pipeline_Base/target/classes',
                        sourcePattern: 'PSW_Pipeline_Base/src/main/java'
                    )
                }
            }
        }

        // ─────────────────────────────────────────────
        // ETAPA 4: Analisis SonarQube
        // ─────────────────────────────────────────────
        stage('SonarQube Analysis') {
            steps {
                echo '>>> [3/5] Analizando calidad de codigo con SonarQube...'
                withSonarQubeEnv('SonarQube') {
                    dir('PSW_Pipeline_Base') {
                        bat "mvn sonar:sonar -Dsonar.projectKey=psw-pipeline-base -Dsonar.projectName=psw-pipeline-base -Dsonar.host.url=http://localhost:9000 -Dsonar.sources=src/main/java -Dsonar.java.binaries=target/classes -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml"
                    }
                }
            }
        }

        // ─────────────────────────────────────────────
        // ETAPA 5: Quality Gate
        // ─────────────────────────────────────────────
        stage('Quality Gate') {
            steps {
                echo '>>> Esperando resultado del Quality Gate de SonarQube...'
                timeout(time: 3, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        // ─────────────────────────────────────────────
        // ETAPA 6: Pruebas de carga con JMeter
        // ─────────────────────────────────────────────
        stage('JMeter Load Test') {
            steps {
                echo '>>> [4/5] Ejecutando pruebas de carga con JMeter...'
                dir('PSW_Pipeline_Base') {
                    bat 'if not exist target\\jmeter\\results mkdir target\\jmeter\\results'
                    bat 'C:/apache-jmeter/bin/jmeter.bat -n -t src/test/jmeter/pipeline_load_test.jmx -l target/jmeter/results/results.jtl -e -o target/jmeter/results/html-report'
                }
            }
            post {
                always {
                    perfReport(
                        sourceDataFiles: 'PSW_Pipeline_Base/target/jmeter/results/results.jtl',
                        errorFailedThreshold: 10,
                        errorUnstableThreshold: 5,
                        relativeFailedThresholdPositive: 50,
                        relativeUnstableThresholdPositive: 30
                    )
                    publishHTML(target: [
                        reportName : 'JMeter HTML Report',
                        reportDir  : 'PSW_Pipeline_Base/target/jmeter/results/html-report',
                        reportFiles: 'index.html',
                        keepAll    : true,
                        alwaysLinkToLastBuild: true
                    ])
                }
            }
        }

    } // end stages

    // ─────────────────────────────────────────────────
    // POST: Notificaciones Slack
    // ─────────────────────────────────────────────────
    post {

        success {
            script {
                echo '>>> [5/5] Pipeline finalizado correctamente. Notificando a Slack...'
                slackSend(
                    channel: '#pipeline-notificaciones',
                    color  : 'good',
                    message: ":white_check_mark: *PIPELINE EXITOSO* - `psw-pipeline-base`\n*Build:* #${env.BUILD_NUMBER}\n*Duracion:* ${currentBuild.durationString}\n*Estado:* ${currentBuild.currentResult}\n<${env.BUILD_URL}|Ver en Jenkins>"
                )
            }
        }

        failure {
            script {
                echo '>>> [5/5] Pipeline FALLO. Notificando a Slack...'
                slackSend(
                    channel: '#pipeline-notificaciones',
                    color  : 'danger',
                    message: ":x: *PIPELINE FALLIDO* - `psw-pipeline-base`\n*Build:* #${env.BUILD_NUMBER}\n*Duracion:* ${currentBuild.durationString}\n<${env.BUILD_URL}|Ver en Jenkins>"
                )
            }
        }

        unstable {
            script {
                slackSend(
                    channel: '#pipeline-notificaciones',
                    color  : 'warning',
                    message: ":warning: *PIPELINE INESTABLE* - `psw-pipeline-base`\n*Build:* #${env.BUILD_NUMBER}\n<${env.BUILD_URL}|Ver en Jenkins>"
                )
            }
        }

        always {
            script {
                echo 'Limpiando workspace...'
            }
            cleanWs()
        }
    }
}
